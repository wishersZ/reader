# ---------- 数据与产物（不进版本库）----------
# 小说数据区：7 本正文 + _backup/ 里编码统一前的原件，体积大且非源码
novels/
# 拆分产物：可随时用 tools/novel_split 重新生成，共约 250 个文件 / 84MB
output/

# ---------- 嵌套的独立仓库 ----------
# projects/reader 是月读自己的 git 仓库，有独立提交历史，不在此仓库重复跟踪
projects/reader/

# ---------- 通用 ----------
node_modules/
dist/
__pycache__/
*.py[cod]
*.log
_appdata/

# 保险：万一有 .bak 落在仓库范围内
*.bak

# ---------- 分析用暂存仓（第三方仓库浅克隆，只读分析，不进版本库）----------
# 由分析任务临时创建，可随时整目录删除；不参与本仓库版本控制
.plugin-stage/
.skillstage/
._skillstage/
# 技能库改动暂存区（改动前后的副本 + 补丁脚本，可整目录删除；回滚用）
.skill-patch/
# 待删暂存区：删除一律先移进来，确认后再永久删除（按原路径镜像，可原样回滚）
_trash/

# ---------- 写书项目内容 ----------
# 与 novels/ 同级：创作内容不进「工具与文档」仓库；要版本化时在该目录单独 git init
混沌冠冕_重写版/

# ---------- NovelKit（EXE 工具箱）----------
# 打包用的 PyInstaller 依赖：由 tools/novelkit/bootstrap_pyinstaller.py 重新获取
tools/novelkit/_pylib/
# 打包中间产物（build.ps1 的 --workpath / --specpath）
.tmp/
# 临时截图（工具截图另存为 tools/novelkit/screenshot.png）
screenshots/

